{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(css|js|svg|jpg|jpeg|png|webp|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
